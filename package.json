{
  "name": "storybook-diff-example",
  "private": true,
  "version": "0.0.0",
  "description": "Example monorepo showing storybook-diff on pull requests",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
